{
  "name": "schedularr",
  "version": "1.0.0",
  "description": "Comprehensive music scheduling application for radio stations",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,ui -c blue,green \"nodemon --watch server server/index.js\" \"npm --prefix ui run dev\"",
    "build": "npm --prefix ui run build",
    "start": "cross-env NODE_ENV=production node server/index.js",
    "lint": "npm --prefix ui run lint"
  },
  "keywords": [
    "radio",
    "music",
    "scheduling",
    "playout"
  ],
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "concurrently": "^10.0.5",
    "cors": "^2.8.6",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.3",
    "express": "^5.2.1",
    "mongoose": "^9.10.2",
    "nodemon": "^3.1.14"
  }
}
